{
    "name": "metaprobe/metaprobe",
    "description": "Extracts, analyzes and sanitizes EXIF, IPTC & XMP metadata in PHP with built-in privacy scanning and CLI",
    "keywords": ["exif", "iptc", "xmp", "metadata", "gps", "privacy", "sanitizer", "forensics"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MetaProbe Team"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-exif": "*",
        "ext-xml": "*",
        "ext-gd": "*",
        "symfony/console": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "MetaProbe\\": "src/"
        }
    },
    "bin": [
        "bin/metaprobe"
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "probe": "php bin/metaprobe probe",
        "sanitize": "php bin/metaprobe sanitize",
        "batch": "php bin/metaprobe batch"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
