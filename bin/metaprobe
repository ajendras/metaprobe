#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace MetaProbe;

use MetaProbe\Console\BatchCommand;
use MetaProbe\Console\ProbeCommand;
use MetaProbe\Console\SanitizeCommand;
use Symfony\Component\Console\Application;

if (file_exists(__DIR__ . '/../vendor/autoload.php')) {
    require_once __DIR__ . '/../vendor/autoload.php';
} elseif (file_exists(__DIR__ . '/../../../autoload.php')) {
    require_once __DIR__ . '/../../../autoload.php';
} else {
    fwrite(STDERR, "Autoloader not found. Please run 'composer install'.\n");
    exit(1);
}

$app = new Application('MetaProbe', '1.1.0');
$app->add(new ProbeCommand());
$app->add(new SanitizeCommand());
$app->add(new BatchCommand());

$app->run();
